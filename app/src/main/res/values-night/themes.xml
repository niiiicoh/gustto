<resources>
  <style name="Theme.Gustto" parent="Theme.Material3.Light.NoActionBar">
    <item name="colorPrimary">@color/burgundy</item>
    <item name="colorOnPrimary">@color/paper</item>
    <item name="colorPrimaryContainer">@color/rose</item>
    <item name="colorOnPrimaryContainer">@color/burgundy</item>
    <item name="colorSecondary">@color/olive</item>
    <item name="colorSurface">@color/cream</item>
    <item name="colorOnSurface">@color/ink</item>
    <item name="android:colorBackground">@color/cream</item>
    <item name="android:fontFamily">sans</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:statusBarColor">@color/cream</item>
    <item name="android:navigationBarColor">@color/cream</item>
    <item name="materialButtonStyle">@style/Gustto.Button</item>
  </style>
  <style name="Gustto.Button" parent="Widget.Material3.Button">
    <item name="cornerRadius">12dp</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:textAllCaps">false</item>
  </style>
  <style name="Gustto.Title" parent="">
    <item name="android:fontFamily">serif</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">28sp</item>
    <item name="android:textColor">@color/ink</item>
  </style>
  <style name="Gustto.Body" parent="">
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">@color/muted</item>
    <item name="android:lineSpacingExtra">3dp</item>
  </style>
</resources>