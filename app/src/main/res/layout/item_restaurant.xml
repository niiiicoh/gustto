<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/paper">
  <LinearLayout android:id="@+id/restaurant_row" android:background="?attr/selectableItemBackground" android:gravity="center_vertical" android:padding="10dp" android:minHeight="112dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/restaurant_image" android:layout_width="86dp" android:layout_height="90dp" android:scaleType="centerCrop" android:importantForAccessibility="no" android:src="@drawable/placeholder_food" />
    <LinearLayout android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="0dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
      <TextView android:id="@+id/restaurant_name" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_width="match_parent" android:layout_height="wrap_content" />
      <TextView android:id="@+id/restaurant_category" style="@style/Gustto.Body" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
      <TextView android:id="@+id/restaurant_rating" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
      <TextView android:id="@+id/restaurant_status" android:textSize="12sp" android:textColor="@color/burgundy" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
    <ImageButton android:id="@+id/restaurant_favorite" android:layout_gravity="top" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_heart" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/favorite" />
  </LinearLayout>
</androidx.cardview.widget.CardView>