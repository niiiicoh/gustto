ngitude)).title(r.name).snippet(\"Toca para ver el detalle\").icon(BitmapDescriptorFactory.defaultMarker(348)));if(m!=null)m.setTag(r.id);}g.setOnInfoWindowClickListener(m->{Object id=m.getTag();if(id!=null){host().repo().seen(id.toString());host().open(DetailFragment.create(id.toString()));}});if(!previewMode()&&hasPermission())locate();}});\n"
